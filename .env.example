# Local development placeholders only. Copy to .env (ignored by Git) and replace secrets.
APP_ENV=development
APP_NAME=FairMount Games
API_HOST=127.0.0.1
API_PORT=8000

# P01-T03 localhost-only PostgreSQL. Never reuse these example values in deployment.
POSTGRES_USER=fairmount
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=fairmount_dev
POSTGRES_TEST_DB=fairmount_test
POSTGRES_PORT=5432
# Legacy local example only; this DATABASE_URL is NOT read by the API readiness probe.
DATABASE_URL=postgresql+psycopg://fairmount:replace-with-a-unique-local-password@127.0.0.1:5432/fairmount_dev
# Optional: provision a protected PostgreSQL URL outside Git as
# FAIRMOUNT_API_DATABASE_URL to enable /health/ready (otherwise HTTP 503).
# Never deploy with the placeholder credentials above.
# Direct-TLS authentication is DISABLED unless an operator configures the
# protected FAIRMOUNT_AUTH_EDGE_MODE=direct-tls, FAIRMOUNT_PUBLIC_ORIGIN=https://...
# and separate restricted FAIRMOUNT_AUTH_HMAC_KEY_FILE and FAIRMOUNT_MFA_KEY_FILE.
# Do not enable direct-tls behind a reverse proxy, including Arena preview.

REDIS_URL=redis://localhost:6379/0
# Session cookies are always Secure in the opt-in direct-TLS boundary; no insecure override.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Generate secrets locally; do not reuse example values in any deployed environment.
APP_SECRET_KEY=replace-with-a-random-local-development-secret
