# Local development placeholders only. Copy to .env (ignored by Git) and replace secrets.
APP_ENV=development
APP_NAME=FairMount Games
API_HOST=127.0.0.1
API_PORT=8000

# P01-T03 localhost-only PostgreSQL. Never reuse these example values in deployment.
POSTGRES_USER=fairmount
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=fairmount_dev
POSTGRES_TEST_DB=fairmount_test
POSTGRES_PORT=5432
# Planned API URL only; the current API does not connect to PostgreSQL.
# If changing POSTGRES_PASSWORD, keep this URL in sync before future API integration.
DATABASE_URL=postgresql+psycopg://fairmount:replace-with-a-unique-local-password@127.0.0.1:5432/fairmount_dev

REDIS_URL=redis://localhost:6379/0
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Generate secrets locally; do not reuse example values in any deployed environment.
APP_SECRET_KEY=replace-with-a-random-local-development-secret
